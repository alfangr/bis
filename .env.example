NEXT_PUBLIC_SITE_URL=https://bis.informakita.my.id
NEXT_PUBLIC_BRAND_NAME=Informakita

# Turso (libSQL) database — required for the app to read/write cities, buses,
# and schedules. Create one with the Turso CLI (turso db create bis-inform),
# then get these with `turso db show bis-inform --url` and
# `turso db tokens create bis-inform`. Run `npm run db:setup` once to create
# the schema and seed initial data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin login (Google OAuth via Auth.js) — required to access /admin and to
# create/edit/delete cities, buses, or schedules.
#
# 1. Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
#    (Application type: Web application).
# 2. Add these as Authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google   (local dev)
#    - <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google  (production)
# 3. Paste the generated Client ID / Client secret below.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random secret Auth.js uses to sign session tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Comma-separated list of Google account emails allowed to log in as admin.
# Defaults to alfangr05@gmail.com if unset.
ADMIN_EMAILS=alfangr05@gmail.com
